# Safe local defaults
PROVIDER_MODE=mock
DATABASE_PATH=/data/platform.db
WORKSPACE_ROOT=/workspace
MAX_PIPELINE_LOOPS=10
SUMMARIZER_INTERVAL=3
PROVIDER_TIMEOUT_SECONDS=120

# Frontend browser-facing API URL
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.2

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AI Software Company

# Local OpenAI-compatible servers: Ollama, vLLM, LM Studio, LocalAI
LOCAL_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_API_KEY=local
LOCAL_MODEL=llama3.1
